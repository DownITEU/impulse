## Caches

store-maps = MAPS
store-maps-hint = pins, regions and icons
store-catalog = CATALOG
store-catalog-hint = the games and your account name
store-trainers = TRAINERS
store-trainers-hint = cheat lists
store-trainer-files = TRAINER FILES
store-trainer-files-hint = trainer DLLs from the CDN
store-browser = BROWSER
store-browser-hint = WebView2 cache

## The folder

folder = WAND FOLDER
folder-hint = where the trainer binaries are read from
folder-empty = no Wand trainer files in this folder
folder-unset = Wand's folder is not set

## Categories

category-challenge = CHALLENGE MODS
category-enemies = ENEMIES
category-game = GAME
category-inventory = INVENTORY
category-physics = PHYSICS
category-player = PLAYER
category-stats = STATS
category-teleport = TELEPORT
category-vehicles = VEHICLES
category-weapons = WEAPONS

## Failures

signed-out = Wand is signed out: open Wand and sign in
not-installed = Wand is not set up on this PC: install it, open it and sign in
